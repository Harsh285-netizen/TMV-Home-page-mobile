@page
@model TMVHomePageMobile.Pages.IndexModel
@{
    ViewData["Title"] = "Home";
}

<main class="phone-frame">

    <header class="site-header">
        <span class="logo">TM<small>VENTURES</small></span>
    </header>

    <section class="fan-carousel" id="fanCarousel" aria-roledescription="carousel" aria-label="Featured releases">
        <div class="fan-stage" id="fanStage">
            @{ var initialRoles = new[] { "left", "center", "right" }; }
            @for (var i = 0; i < Model.Slides.Count; i++)
            {
                var slide = Model.Slides[i];
                var initialRole = initialRoles[i % initialRoles.Length];
                <div class="fan-card fan-card--@initialRole @slide.ImageClass"
                     data-slide-index="@i"
                     data-role="@initialRole"
                     role="group"
                     aria-roledescription="slide"
                     aria-current="@(initialRole == "center" ? "true" : "false")"
                     aria-label="@(i + 1) of @Model.Slides.Count">
                    <span class="fan-card__label">@slide.Alt</span>
                </div>
            }

            <div class="now-playing-pill" id="nowPlayingPill" aria-hidden="true">
                <span class="now-playing-pill__bar"></span>
                <span class="now-playing-pill__bar"></span>
                <span class="now-playing-pill__bar"></span>
                <span class="now-playing-pill__bar"></span>
            </div>
        </div>
    </section>

    <section class="intro-copy">
        <p>
            We believe in working together towards a common goal of promoting music in India and
            beyond, while fostering a non-judgmental and supportive space for artists and listeners
            alike.
        </p>
        <h1 class="headline">
            <span class="headline__accent">ARTISTE-</span>
            <span class="headline__base">FIRST LABEL</span>
        </h1>
    </section>

    <footer class="player-bar" id="playerBar">
        <button type="button" class="player-bar__arrow" id="prevBtn" aria-label="Previous">
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                <path d="M15 6l-6 6 6 6" fill="none" stroke="currentColor" stroke-width="2"
                      stroke-linecap="round" stroke-linejoin="round" />
            </svg>
        </button>

        <button type="button" class="player-bar__arrow" id="nextBtn" aria-label="Next">
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                <path d="M9 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2"
                      stroke-linecap="round" stroke-linejoin="round" />
            </svg>
        </button>

        @{ var centerSlide = Model.Slides[1]; }
        <div class="player-bar__meta" aria-live="polite">
            <span class="player-bar__track" id="trackTitle">@centerSlide.Track</span>
            <span class="player-bar__artist" id="trackArtist">by @centerSlide.Artist</span>
        </div>

        <button type="button" class="player-bar__play" id="playBtn" aria-label="Play" aria-pressed="false">
            <svg class="icon-play" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
                <path d="M8 5v14l11-7z" fill="currentColor" />
            </svg>
            <svg class="icon-pause" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
                <path d="M7 5h4v14H7zM13 5h4v14h-4z" fill="currentColor" />
            </svg>
        </button>
    </footer>

    <audio id="audioEl" preload="none"></audio>
</main>

@section Scripts {
    <script>
        window.tmvSlides = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Slides));
    </script>
}
